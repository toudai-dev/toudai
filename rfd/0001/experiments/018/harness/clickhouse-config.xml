<?xml version="1.0"?>
<!-- Disposable ClickHouse 26.8.2.7 test server for Experiment 018.
     All state lives under LH018_ROOT; ports are loopback-only and do not
     collide with the repository's docker-compose or benchmark harness. -->
<clickhouse>
    <logger>
        <level>warning</level>
        <console>false</console>
        <log from_env="LH018_CH_LOG"/>
        <errorlog from_env="LH018_CH_ERRORLOG"/>
        <size>50M</size>
        <count>2</count>
    </logger>

    <http_port>18123</http_port>
    <tcp_port>19000</tcp_port>
    <listen_host>127.0.0.1</listen_host>

    <max_connections>64</max_connections>
    <max_concurrent_queries>8</max_concurrent_queries>
    <!-- The orb has ~3 GiB RAM; keep the server and the Collector inside it. -->
    <max_server_memory_usage>1073741824</max_server_memory_usage>
    <mark_cache_size>67108864</mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <mlock_executable>false</mlock_executable>
    <async_insert_threads>2</async_insert_threads>

    <path from_env="LH018_CH_PATH"/>
    <tmp_path from_env="LH018_CH_TMP"/>
    <user_files_path from_env="LH018_CH_USER_FILES"/>
    <format_schema_path from_env="LH018_CH_FORMAT_SCHEMAS"/>

    <users_config from_env="LH018_CH_USERS"/>
    <default_profile>default</default_profile>
    <default_database>default</default_database>
</clickhouse>
