<?xml version="1.0"?>
<!-- Disposable ClickHouse 26.8.2.7 test server for Experiment 020.
     All state lives under LH020_ROOT; ports are loopback-only and do not
     collide with the Experiment 019 harness (18124/19001) or the repository's
     docker-compose. -->
<clickhouse>
    <logger>
        <level>warning</level>
        <console>false</console>
        <log from_env="LH020_CH_LOG"/>
        <errorlog from_env="LH020_CH_ERRORLOG"/>
        <size>50M</size>
        <count>2</count>
    </logger>

    <http_port>18125</http_port>
    <tcp_port>19002</tcp_port>
    <listen_host>127.0.0.1</listen_host>

    <max_connections>64</max_connections>
    <max_concurrent_queries>8</max_concurrent_queries>
    <!-- The orb has ~3 GiB RAM; keep the server inside it. -->
    <max_server_memory_usage>1073741824</max_server_memory_usage>
    <mark_cache_size>67108864</mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <mlock_executable>false</mlock_executable>
    <async_insert_threads>2</async_insert_threads>

    <!-- Capture the executed query statements so the cost measurements read
         read_rows/read_bytes/duration/CPU from the server's own log. -->
    <query_log>
        <database>system</database>
        <table>query_log</table>
        <flush_interval_milliseconds>500</flush_interval_milliseconds>
    </query_log>

    <path from_env="LH020_CH_PATH"/>
    <tmp_path from_env="LH020_CH_TMP"/>
    <user_files_path from_env="LH020_CH_USER_FILES"/>
    <format_schema_path from_env="LH020_CH_FORMAT_SCHEMAS"/>

    <users_config from_env="LH020_CH_USERS"/>
    <default_profile>default</default_profile>
    <default_database>default</default_database>
</clickhouse>
