<?xml version="1.0"?>
<clickhouse>
    <logger>
        <level>information</level>
        <console>false</console>
        <size>100M</size>
        <count>5</count>
    </logger>

    <!-- Keep the benchmark server isolated from development ClickHouse. -->
    <http_port>18123</http_port>
    <tcp_port>19000</tcp_port>
    <listen_host>127.0.0.1</listen_host>

    <max_connections>128</max_connections>
    <max_concurrent_queries>24</max_concurrent_queries>
    <max_server_memory_usage_to_ram_ratio>0.85</max_server_memory_usage_to_ram_ratio>
    <mark_cache_size>8589934592</mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>

    <!-- Lifecycle scripts override these paths for each benchmark root. -->
    <path>/mnt/fast-storage/lighthouse/clickhouse/data/</path>
    <tmp_path>/mnt/fast-storage/lighthouse/clickhouse/tmp/</tmp_path>
    <user_files_path>/mnt/fast-storage/lighthouse/clickhouse/user_files/</user_files_path>
    <format_schema_path>/mnt/fast-storage/lighthouse/clickhouse/format_schemas/</format_schema_path>

    <users_config>users.xml</users_config>
    <user_directories>
        <users_xml>
            <path>users.xml</path>
        </users_xml>
    </user_directories>

    <default_profile>default</default_profile>
    <default_database>default</default_database>
    <timezone>UTC</timezone>
    <mlock_executable>false</mlock_executable>

    <query_log>
        <database>system</database>
        <table>query_log</table>
        <flush_interval_milliseconds>1000</flush_interval_milliseconds>
    </query_log>
</clickhouse>
