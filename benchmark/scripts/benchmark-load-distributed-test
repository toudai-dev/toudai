#!/usr/bin/env bash
# Integration test for the Stage B distributed loader's per-batch gates.
#
# Runs the unmodified `benchmark-load-distributed` loader against a
# self-referential single-node ClickHouse instance and a synthetic two-day
# corpus served through a `gcloud` shim, then checks the fresh-load, resume,
# recovery, partial-batch, and clean-reload paths. The shim only stands in for
# the object store, so the gates under test are the same ones an S3 run uses.
# Requires the committed Flox environment for `clickhouse` and Python.
set -Eeuo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
loader="${repo_root}/benchmark/scripts/benchmark-load-distributed"
transform="${repo_root}/benchmark/clickhouse/gcp-parquet-to-events.sql"
work="$(mktemp -d "${TMPDIR:-/tmp}/lighthouse-stage-b-loader-test.XXXXXX")"
run_id="loader-test-1s"
run_dir="${work}/runs/${run_id}"
corpus="${work}/corpus"
markers="${work}/markers"
shim="${work}/shim"
server_root="${work}/server"
scratch="benchmark_distributed_expected"

structure="timestamp Nullable(DateTime64(6, 'UTC')), timestamp_unix_nanos Nullable(Int64), receive_timestamp Nullable(DateTime64(6, 'UTC')), receive_timestamp_unix_nanos Nullable(Int64), severity Nullable(String), severity_number Nullable(Int64), log_name Nullable(String), resource_type Nullable(String), resource_labels Nullable(String), labels Nullable(String), insert_id Nullable(String), trace Nullable(String), span_id Nullable(String), trace_sampled Nullable(Bool), raw_entry Nullable(String)"

server_pid=""
completed=0
cleanup() {
  local rc=$? pid=""
  if [[ -f "${server_root}/run/clickhouse.pid" ]]; then
    pid="$(cat "${server_root}/run/clickhouse.pid" 2>/dev/null || true)"
  fi
  [[ -n "${pid}" ]] || pid="${server_pid}"
  if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
    kill "${pid}" 2>/dev/null || true
    for _ in $(seq 1 30); do
      kill -0 "${pid}" 2>/dev/null || break
      sleep 1
    done
    kill -9 "${pid}" 2>/dev/null || true
  fi
  # Keep the scratch tree on failure so the server log stays inspectable.
  if [[ "${completed}" == 1 ]]; then
    rm -rf "${work}"
  fi
  return "${rc}"
}
trap cleanup EXIT

# The loader's client port is fixed at 9000; fail early instead of racing a
# stale test instance from an interrupted run.
if ss -ltn 2>/dev/null | grep -q ':9000 '; then
  echo "port 9000 is already in use; stop the process holding it before testing" >&2
  exit 1
fi

mkdir -p "${work}"/{corpus,markers,shim,server/data,server/tmp,server/user_files,server/format_schemas,server/logs,server/run}
mkdir -p "${corpus}/2026-08-01" "${corpus}/2026-08-02"

# The cluster is a single instance that is also its own shard, which is enough
# to exercise the Distributed insert path and the coordinator-side gates.
cat > "${server_root}/users.xml" <<'XML'
<?xml version="1.0"?>
<clickhouse>
    <profiles>
        <default>
            <max_memory_usage>8589934592</max_memory_usage>
            <max_threads>4</max_threads>
            <use_uncompressed_cache>0</use_uncompressed_cache>
        </default>
    </profiles>
    <users>
        <default>
            <password></password>
            <networks><ip>127.0.0.1</ip><ip>::1</ip></networks>
            <profile>default</profile><quota>default</quota>
        </default>
    </users>
    <quotas><default><interval><duration>3600</duration></interval></default></quotas>
</clickhouse>
XML

cat > "${server_root}/config.xml" <<XML
<?xml version="1.0"?>
<clickhouse>
    <logger><level>warning</level><console>false</console><size>50M</size><count>2</count></logger>
    <http_port>18124</http_port>
    <tcp_port>9000</tcp_port>
    <listen_host>127.0.0.1</listen_host>
    <max_connections>128</max_connections>
    <max_server_memory_usage_to_ram_ratio>0.25</max_server_memory_usage_to_ram_ratio>
    <path>${server_root}/data/</path>
    <tmp_path>${server_root}/tmp/</tmp_path>
    <user_files_path>${server_root}/user_files/</user_files_path>
    <format_schema_path>${server_root}/format_schemas/</format_schema_path>
    <users_config>${server_root}/users.xml</users_config>
    <user_directories><users_xml><path>${server_root}/users.xml</path></users_xml></user_directories>
    <default_profile>default</default_profile>
    <default_database>default</default_database>
    <timezone>UTC</timezone>
    <mlock_executable>false</mlock_executable>
    <remote_servers>
        <lighthouse>
            <shard>
                <internal_replication>false</internal_replication>
                <replica><host>127.0.0.1</host><port>9000</port><user>default</user></replica>
            </shard>
        </lighthouse>
    </remote_servers>
    <query_log>
        <database>system</database>
        <table>query_log</table>
        <flush_interval_milliseconds>1000</flush_interval_milliseconds>
    </query_log>
</clickhouse>
XML

clickhouse server --config-file="${server_root}/config.xml" --daemon \
  --pid-file="${server_root}/run/clickhouse.pid" \
  --log-file="${server_root}/logs/server.log" \
  --errorlog-file="${server_root}/logs/server.err.log"
for _ in $(seq 1 30); do
  [[ -f "${server_root}/run/clickhouse.pid" ]] && break
  sleep 1
done
if [[ ! -f "${server_root}/run/clickhouse.pid" ]]; then
  echo "ClickHouse test instance failed to start" >&2
  cat "${server_root}/logs/server.err.log" >&2 || true
  exit 1
fi
server_pid="$(cat "${server_root}/run/clickhouse.pid")"

for _ in $(seq 1 60); do
  clickhouse client --host 127.0.0.1 --port 9000 --query "SELECT 1" >/dev/null 2>&1 && break
  sleep 1
done
clickhouse client --host 127.0.0.1 --port 9000 --query "SELECT 1" >/dev/null

make_day() {
  local day="$1" count="$2" out="$3"
  python3 - "${day}" "${count}" <<'PY' > "${work}/day.tsv"
import json
import sys

day, count = sys.argv[1], int(sys.argv[2])
for i in range(count):
    timestamp = f"{day} 12:{i % 60:02d}:{i % 60:02d}.000000"
    payload = {
        "type": "event_lifecycle",
        "workspace_id": f"w{i % 7}",
        "duration": f"{i % 100}.{i % 10}",
        "caller": f"svc-{i % 5}",
    }
    raw = json.dumps({"text_payload": f"message-{i}", "json_payload": json.dumps(payload)})
    print("\t".join([
        timestamp, str(i * 1000), timestamp, str(i * 1000), "ERROR", "500",
        "projects/lighthouse/logs/app", "gce_instance",
        '{"zone":"us-central1-a"}',
        '{"service.name":"executor","service.namespace":"prod"}',
        f"evt-{day}-{i:06d}", "projects/lighthouse/traces/trace1", f"span{i:06d}", "true",
        raw,
    ]))
PY
  clickhouse local --query "SELECT * FROM table FORMAT Parquet" \
    --structure "${structure}" --input-format TSV < "${work}/day.tsv" > "${out}"
}

make_day 2026-08-01 2000 "${corpus}/2026-08-01/part-000.parquet"
make_day 2026-08-02 1500 "${corpus}/2026-08-02/part-000.parquet"

# Expected rows and checksums come from the same transform the loader uses.
clickhouse client --host 127.0.0.1 --port 9000 --multiquery --query "
  DROP DATABASE IF EXISTS ${scratch};
  CREATE DATABASE ${scratch};
  CREATE TABLE ${scratch}.events
  (
    tenant_id UInt64, dataset LowCardinality(String), timestamp DateTime64(6, 'UTC'),
    observed_at DateTime64(6, 'UTC'), event_id String,
    event_kind Enum8('event' = 1, 'log' = 2, 'span' = 3),
    event_name LowCardinality(String), body String,
    service_name LowCardinality(String), environment LowCardinality(String),
    severity LowCardinality(String), status_code LowCardinality(String),
    trace_id String, span_id String, parent_span_id String, span_kind LowCardinality(String),
    duration_ns UInt64, resource Map(LowCardinality(String), String),
    scope Map(LowCardinality(String), String), attributes Map(LowCardinality(String), String)
  ) ENGINE = MergeTree PARTITION BY toDate(timestamp) ORDER BY (tenant_id, dataset, timestamp, event_id);"

inventory="${work}/corpus.tsv"
printf 'day\tfiles\tparquet_bytes\trows\thot_checksum\n' > "${inventory}"
previous_cumulative=0
for day in 2026-08-01 2026-08-02; do
  file="${corpus}/${day}/part-000.parquet"
  rows="$(clickhouse local --input-format Parquet --structure "${structure}" --query "SELECT count() FROM table" < "${file}")"
  clickhouse local --max_threads=2 --input-format Parquet --structure "${structure}" \
    --queries-file "${transform}" < "${file}" |
    clickhouse client --host 127.0.0.1 --port 9000 --query "INSERT INTO ${scratch}.events FORMAT Native"
  cumulative="$(clickhouse client --host 127.0.0.1 --port 9000 --query "SELECT sum(sipHash64(event_id, timestamp, attributes, resource, body)) FROM ${scratch}.events FORMAT TSVRaw")"
  # The inventory records each day's own contribution; the loader sums them.
  checksum="$(python3 -c "print((${cumulative} - ${previous_cumulative}) % 2**64)")"
  previous_cumulative="${cumulative}"
  printf '%s\t1\t%s\t%s\t%s\n' "${day}" "$(stat -c %s "${file}")" "${rows}" "${checksum}" >> "${inventory}"
done

cat > "${shim}/gcloud" <<'SHIM'
#!/usr/bin/env bash
set -euo pipefail
corpus_root="${LIGHTHOUSE_TEST_CORPUS_ROOT}"
marker_root="${LIGHTHOUSE_TEST_MARKER_ROOT}"
case "${1:-} ${2:-}" in
  "storage ls")
    target="$3"
    if [[ "${target}" == */corpus/* ]]; then
      rel="${target#*corpus/}"; rel="${rel%/\*\*}"
      for file in "${corpus_root}/${rel}"/*.parquet; do
        [[ -e "${file}" ]] && echo "gs://test/corpus/${rel}/$(basename "${file}")"
      done
    else
      rel="${target#gs://test/}"
      [[ -f "${marker_root}/${rel}" ]] || exit 1
    fi
    ;;
  "storage du")
    prefix="${4:-${3}}"; rel="${prefix#*corpus/}"; rel="${rel%/}"
    total=0
    for file in "${corpus_root}/${rel}"/*.parquet; do total=$((total + $(stat -c %s "${file}"))); done
    echo "${total} bytes ${prefix}"
    ;;
  "storage cp")
    src="$3"; dst="$4"
    if [[ "${src}" == gs://* ]]; then
      rel="${src#*corpus/}"; cp "${corpus_root}/${rel}" "${dst}"
    else
      rel="${dst#gs://test/}"; mkdir -p "$(dirname "${marker_root}/${rel}")"; cp "${src}" "${marker_root}/${rel}"
    fi
    ;;
  *) echo "unsupported shim call: $*" >&2; exit 2 ;;
esac
SHIM
chmod +x "${shim}/gcloud"

export LIGHTHOUSE_TEST_CORPUS_ROOT="${corpus}"
export LIGHTHOUSE_TEST_MARKER_ROOT="${markers}"
export PATH="${shim}:${PATH}"
export LIGHTHOUSE_CLUSTER_COORDINATOR_HOST=127.0.0.1
export LIGHTHOUSE_CLUSTER_LEAF_HOSTS=127.0.0.1
export LIGHTHOUSE_BENCH_RUNS_ROOT="${work}/runs"
export LIGHTHOUSE_GCP_CORPUS_BUCKET=gs://test
export LIGHTHOUSE_GCP_CORPUS_INVENTORY="${inventory}"
export LIGHTHOUSE_GCP_LOAD_PARALLELISM=2
export LIGHTHOUSE_BENCH_REVISION=loader-test

assert_day_rows() {
  [[ "$(clickhouse client --host 127.0.0.1 --port 9000 --query 'SELECT count() FROM benchmark_distributed.events FORMAT TSVRaw')" == "$1" ]] ||
    { echo "expected ${1} distributed rows" >&2; exit 1; }
}

echo "== fresh load =="
"${loader}" 1 "${run_id}"
[[ "$(cat "${run_dir}/status")" == completed ]]
[[ "$(wc -l < "${run_dir}/days.tsv")" == 3 ]]
assert_day_rows 3500

echo "== idempotent rerun =="
"${loader}" 1 "${run_id}" | grep -q 'already complete'

echo "== recovery when a completed batch lost its marker =="
rm -f "${run_dir}/state/days/2026-08-02.done"
echo loading > "${run_dir}/status"
"${loader}" 1 "${run_id}"
grep -q '^recovered' "${run_dir}/state/days/2026-08-02.done"
[[ "$(tail -n1 "${run_dir}/days.tsv" | cut -f4)" == 0 ]]

echo "== partial source batch is rejected =="
rm -f "${run_dir}/state/days/2026-08-02.done"
echo loading > "${run_dir}/status"
clickhouse client --host 127.0.0.1 --port 9000 --query "ALTER TABLE benchmark_distributed.events_local DELETE WHERE event_id LIKE 'evt-2026-08-02-000%' SETTINGS mutations_sync=1"
assert_day_rows 2500
set +e
"${loader}" 1 "${run_id}" > "${work}/partial.log" 2>&1
rc=$?
set -e
[[ "${rc}" != 0 ]] || { echo "partial source batch was accepted" >&2; exit 1; }
grep -q '^reason=partial-source-batch$' "${run_dir}/failure.txt"

echo "== clean reload after discarding the partial rows =="
clickhouse client --host 127.0.0.1 --port 9000 --query "TRUNCATE TABLE benchmark_distributed.events_local"
rm -f "${run_dir}/state/days/"*.done "${run_dir}/days.tsv" "${run_dir}/status"
"${loader}" 1 "${run_id}"
[[ "$(cat "${run_dir}/status")" == completed ]]
assert_day_rows 3500

echo "benchmark-load-distributed-test: PASS"
completed=1
