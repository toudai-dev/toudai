#!/usr/bin/env bash
set -Eeuo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
shards="${1:-}"
run_prefix="${2:-}"
coordinator="${LIGHTHOUSE_CLUSTER_COORDINATOR_HOST:-}"
leaves="${LIGHTHOUSE_CLUSTER_LEAF_HOSTS:-}"
runs_root="${LIGHTHOUSE_BENCH_RUNS_ROOT:-${HOME}/lighthouse-stage-b/runs}"
load_run="${LIGHTHOUSE_DISTRIBUTED_LOAD_RUN:-}"
bucket="${LIGHTHOUSE_GCP_CORPUS_BUCKET:-gs://lighthouse-508219-lighthouse-exp015}"
expected_rows="${LIGHTHOUSE_BENCH_EXPECTED_ROWS:-5689254359}"
day_end="${LIGHTHOUSE_DISTRIBUTED_DAY_END:-2026-08-11 04:00:00}"
ranges="${LIGHTHOUSE_DISTRIBUTED_RANGES:-5m,1h,6h,24h,10d}"
revision="${LIGHTHOUSE_BENCH_REVISION:-unknown}"
poll_seconds="${LIGHTHOUSE_STAGE_POLL_SECONDS:-60}"
max_wait_seconds="${LIGHTHOUSE_STAGE_MAX_WAIT_SECONDS:-129600}"

usage() {
  echo "usage: LIGHTHOUSE_DISTRIBUTED_LOAD_RUN=RUN $0 SHARDS RUN_PREFIX" >&2
  exit 2
}
[[ -n "${shards}" && -n "${run_prefix}" && -n "${coordinator}" && -n "${leaves}" && -n "${load_run}" ]] || usage
case "${shards}" in 1|2|4) ;; *) usage ;; esac
[[ "${run_prefix}" =~ ^[A-Za-z0-9._-]+$ ]] || usage
[[ "${poll_seconds}" =~ ^[1-9][0-9]*$ && "${max_wait_seconds}" =~ ^[1-9][0-9]*$ ]] || usage

raw_run="${run_prefix}-raw"
acceleration_run="${run_prefix}-acceleration"
stage_run="${run_prefix}-stage"
stage_dir="${runs_root}/${stage_run}"
archive="${runs_root}/${stage_run}.tar.gz"
remote_archive="${bucket%/}/artifacts/stage-b/${stage_run}/${stage_run}.tar.gz"
cluster_command="${repo_root}/benchmark/scripts/benchmark-clickhouse-remote-cluster"

if [[ -e "${stage_dir}" ]]; then
  echo "stage run already exists: ${stage_dir}" >&2
  exit 1
fi
mkdir -p "${stage_dir}"
cat > "${stage_dir}/config.txt" <<EOF
shards=${shards}
run_prefix=${run_prefix}
load_run=${load_run}
expected_rows=${expected_rows}
day_end=${day_end}
ranges=${ranges}
revision=${revision}
EOF
date -u +%FT%TZ > "${stage_dir}/started-at"
echo waiting-for-load > "${stage_dir}/status"

completed=0
failure_line=unknown
failure_command=unknown
failure_reason=unknown
record_error() {
  failure_line="$2"
  failure_command="$3"
  [[ "${failure_reason}" != unknown ]] || failure_reason=command-failed
}
fail() {
  failure_reason="$1"
  echo "$2" >&2
  return 1
}
upload_archive() {
  local paths=("${stage_run}")
  [[ ! -d "${runs_root}/${raw_run}" ]] || paths+=("${raw_run}")
  [[ ! -d "${runs_root}/${acceleration_run}" ]] || paths+=("${acceleration_run}")
  tar -C "${runs_root}" -czf "${archive}" "${paths[@]}"
  gcloud storage cp "${archive}" "${remote_archive}" --cache-control=no-store
}
on_exit() {
  local rc=$?
  if (( ! completed )); then
    echo failed > "${stage_dir}/status"
    date -u +%FT%TZ > "${stage_dir}/failed-at"
    printf 'reason=%s\nexit_code=%s\nline=%s\ncommand=%q\n' \
      "${failure_reason}" "${rc}" "${failure_line}" "${failure_command}" \
      > "${stage_dir}/failure.txt"
    upload_archive || true
  fi
  return "${rc}"
}
trap 'record_error "$?" "$LINENO" "$BASH_COMMAND"' ERR
trap on_exit EXIT

waited=0
while true; do
  load_status="$(cat "${runs_root}/${load_run}/status" 2>/dev/null || echo missing)"
  case "${load_status}" in
    completed) break ;;
    failed)
      fail load-failed "load run failed: ${load_run}"
      ;;
    initializing|loading|validating|missing) ;;
    *)
      fail invalid-load-status "unexpected load status '${load_status}': ${load_run}"
      ;;
  esac
  if (( waited >= max_wait_seconds )); then
    fail load-timeout "timed out waiting for load run: ${load_run}"
  fi
  sleep "${poll_seconds}"
  waited=$((waited + poll_seconds))
done

common_env=(
  env
  "LIGHTHOUSE_CLUSTER_COORDINATOR_HOST=${coordinator}"
  "LIGHTHOUSE_CLUSTER_LEAF_HOSTS=${leaves}"
  "LIGHTHOUSE_DISTRIBUTED_CLUSTER_COMMAND=${cluster_command}"
  "LIGHTHOUSE_BENCH_RUNS_ROOT=${runs_root}"
  "LIGHTHOUSE_DISTRIBUTED_LOAD_RUN=${load_run}"
  "LIGHTHOUSE_BENCH_EXPECTED_ROWS=${expected_rows}"
  "LIGHTHOUSE_DISTRIBUTED_DAY_END=${day_end}"
  "LIGHTHOUSE_DISTRIBUTED_RANGES=${ranges}"
  "LIGHTHOUSE_DISTRIBUTED_HOST_SAMPLER=0"
  "LIGHTHOUSE_BENCH_REVISION=${revision}"
)

echo raw-queries > "${stage_dir}/status"
"${common_env[@]}" "${repo_root}/benchmark/scripts/benchmark-run-distributed-queries" \
  "${shards}" "${raw_run}"

echo accelerations > "${stage_dir}/status"
"${common_env[@]}" \
  "LIGHTHOUSE_BENCH_RESET=1" \
  "LIGHTHOUSE_DISTRIBUTED_RAW_RUN=${raw_run}" \
  "${repo_root}/benchmark/scripts/benchmark-run-distributed-accelerations" \
  "${shards}" "${acceleration_run}"

date -u +%FT%TZ > "${stage_dir}/completed-at"
echo completed > "${stage_dir}/status"
upload_archive
completed=1
trap - EXIT
echo "GCP distributed stage completed: ${stage_dir}"
