#!/usr/bin/env bash
# Append a one-line Stage B phase status sample on a fixed interval.
#
# Read-only by design: it never exports, never destroys, and never touches the
# topology. It exists so a phase that runs for most of a day has a progress trail
# at a chosen granularity, while teardown stays with `finish-phase`, which acts on
# the run's terminal status. Sampling more often than teardown reacts is
# deliberate: this is for watching, not for acting.
set -Eeuo pipefail

shards="${1:?usage: $0 SHARDS RUN_PREFIX STAGE_RUN LOAD_RUN}"
run_prefix="${2:?usage: $0 SHARDS RUN_PREFIX STAGE_RUN LOAD_RUN}"
stage_run="${3:?usage: $0 SHARDS RUN_PREFIX STAGE_RUN LOAD_RUN}"
load_run="${4:?usage: $0 SHARDS RUN_PREFIX STAGE_RUN LOAD_RUN}"

region="${TOUDAI_AWS_REGION:-us-west-2}"
profile_args=()
[[ -n "${TOUDAI_AWS_PROFILE:-}" ]] && profile_args=(--profile "${TOUDAI_AWS_PROFILE}")
aws_cmd=(aws "${profile_args[@]}" --region "${region}")
runs_root="${TOUDAI_BENCH_RUNS_ROOT:-/home/lighthouse/lighthouse-stage-b/runs}"
interval="${TOUDAI_SAMPLE_SECONDS:-300}"
log_file="${TOUDAI_SAMPLE_LOG:-${HOME}/lighthouse-benchmark/status-${stage_run}.tsv}"

[[ "${interval}" =~ ^[1-9][0-9]*$ ]] || { echo "TOUDAI_SAMPLE_SECONDS must be a positive integer" >&2; exit 2; }
mkdir -p "$(dirname -- "${log_file}")"

# The load generator holds the run state, so its instance ID is both what
# `sample` talks to and the signal that the run still exists at all.
loadgen_running() {
  "${aws_cmd[@]}" ec2 describe-instances \
    --filters "Name=tag:Name,Values=lighthouse-exp015-stage-b-loadgen" "Name=instance-state-name,Values=running" \
    --query 'Reservations[].Instances[].InstanceId' --output text
}
loadgen_id="$(loadgen_running)"
if [[ -z "${loadgen_id}" ]]; then
  printf '%s\tno-loadgen\n' "$(date -u +%FT%TZ)" >> "${log_file}"
  exit 1
fi
coordinator_ip="$("${aws_cmd[@]}" ec2 describe-instances \
  --filters "Name=tag:Name,Values=lighthouse-exp015-stage-b-coordinator" "Name=instance-state-name,Values=running" \
  --query 'Reservations[].Instances[].PrivateIpAddress' --output text)"

# One Session Manager command per sample, rather than one per value, so a sample
# costs a single round trip.
sample() {
  local script_file params command_id status
  script_file="$(mktemp)"
  # shellcheck disable=SC2064
  trap "rm -f '${script_file}'" RETURN
  cat > "${script_file}" <<REMOTE
set -u
base=${runs_root}
printf 'stage=%s\n' "\$(cat \${base}/${stage_run}/status 2>/dev/null || echo missing)"
printf 'load=%s\n' "\$(cat \${base}/${load_run}/status 2>/dev/null || echo missing)"
printf 'days=%s\n' "\$((\$(wc -l < \${base}/${load_run}/days.tsv 2>/dev/null || echo 1) - 1))"
bin=\$(flox activate --dir /opt/lighthouse -- which clickhouse 2>/dev/null) || bin=clickhouse
"\${bin}" client --host ${coordinator_ip} --port 9000 \
  --query 'SELECT count() FROM benchmark_distributed.events FORMAT TSVRaw' 2>/dev/null || echo unknown
REMOTE
  params="$(python3 -c 'import json,sys; print(json.dumps({"commands": [open(sys.argv[1]).read()]}))' "${script_file}")"
  command_id="$("${aws_cmd[@]}" ssm send-command --instance-ids "${loadgen_id}" \
    --document-name AWS-RunShellScript --parameters "${params}" \
    --query 'Command.CommandId' --output text)" || return 1
  for _poll in $(seq 1 60); do
    status="$("${aws_cmd[@]}" ssm get-command-invocation --command-id "${command_id}" \
      --instance-id "${loadgen_id}" --query 'Status' --output text 2>/dev/null || echo Pending)"
    case "${status}" in Pending|InProgress|Delayed) sleep 5 ;; *) break ;; esac
  done
  [[ "${status}" == Success ]] || return 1
  "${aws_cmd[@]}" ssm get-command-invocation --command-id "${command_id}" \
    --instance-id "${loadgen_id}" --query 'StandardOutputContent' --output text
}

printf '# sampled_at\tshards\trun_prefix\tstage\tload\tdays\trows\n' >> "${log_file}"
while true; do
  # Re-check every cycle. A startup-only check let this loop outlive a torn-down
  # topology and append unreachable samples forever, so the run's own teardown
  # could not end it.
  if [[ -z "$(loadgen_running)" ]]; then
    printf '%s\tno-loadgen\n' "$(date -u +%FT%TZ)" >> "${log_file}"
    exit 0
  fi
  state="$(sample 2>/dev/null || printf 'stage=unreachable\nload=unreachable\ndays=0\nunknown\n')"
  printf '%s\t%s\t%s\t%s\n' \
    "$(date -u +%FT%TZ)" "${shards}" "${run_prefix}" \
    "$(tr '\n' '\t' <<< "${state}" | sed 's/\t$//')" >> "${log_file}"
  sleep "${interval}"
done
