#!/usr/bin/env bash
# Wait for a Stage B phase to reach a terminal status, export its evidence and
# cost, verify the archive, and destroy the topology.
#
# This exists so the long wait cannot leave a fleet running. Teardown is driven
# by the run's own status rather than by an operator being awake, and the
# failure path still exports failure evidence before destroying. The node-level
# lifetime ceiling remains the backstop if this process dies.
set -Eeuo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../../.." && pwd)"
shards="${1:?usage: $0 SHARDS RUN_PREFIX STAGE_RUN LOAD_RUN}"
run_prefix="${2:?usage: $0 SHARDS RUN_PREFIX STAGE_RUN LOAD_RUN}"
stage_run="${3:?usage: $0 SHARDS RUN_PREFIX STAGE_RUN LOAD_RUN}"
load_run="${4:?usage: $0 SHARDS RUN_PREFIX STAGE_RUN LOAD_RUN}"

region="${LIGHTHOUSE_AWS_REGION:-us-west-2}"
profile_args=()
[[ -n "${LIGHTHOUSE_AWS_PROFILE:-}" ]] && profile_args=(--profile "${LIGHTHOUSE_AWS_PROFILE}")
aws_cmd=(aws "${profile_args[@]}" --region "${region}")
bucket="${LIGHTHOUSE_CORPUS_BUCKET:-s3://lighthouse-exp015-benchmark-828361646739}"
runs_root="${LIGHTHOUSE_BENCH_RUNS_ROOT:-/home/lighthouse/lighthouse-stage-b/runs}"
poll_seconds="${LIGHTHOUSE_PHASE_POLL_SECONDS:-600}"
# Default to the topology's own ceiling less an hour, so this never destroys a
# run the node timer would have allowed to finish.
lifetime_hours="${LIGHTHOUSE_PHASE_LIFETIME_HOURS:-24}"
max_wait_seconds="${LIGHTHOUSE_PHASE_MAX_WAIT_SECONDS:-$(((lifetime_hours - 1) * 3600))}"
stage_dir="benchmark/cloud/aws/stage-b"
out_dir="${LIGHTHOUSE_PHASE_OUT_DIR:-${HOME}/lighthouse-benchmark/phases/${stage_run}}"

mkdir -p "${out_dir}"
log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" | tee -a "${out_dir}/phase.log"; }

instance_ids=()
while IFS= read -r id; do [[ -n "${id}" ]] && instance_ids+=("${id}"); done < <(
  "${aws_cmd[@]}" ec2 describe-instances \
    --filters "Name=tag:experiment,Values=015" "Name=tag:stage,Values=b" "Name=instance-state-name,Values=running" \
    --query 'Reservations[].Instances[].InstanceId' --output text | tr '\t' '\n'
)
(( ${#instance_ids[@]} > 0 )) || { log "no running Stage B instances; nothing to watch"; exit 1; }
log "watching ${#instance_ids[@]} instance(s) for ${stage_run}, poll ${poll_seconds}s, timeout ${max_wait_seconds}s"

loadgen_id="$("${aws_cmd[@]}" ec2 describe-instances \
  --filters "Name=tag:Name,Values=lighthouse-exp015-stage-b-loadgen" "Name=instance-state-name,Values=running" \
  --query 'Reservations[].Instances[].InstanceId' --output text)"
[[ -n "${loadgen_id}" ]] || { log "load generator not found"; exit 1; }

# Reads one file from the load generator and prints it. Returns non-zero when the
# file is missing, which is how a not-yet-written status is detected.
remote_read() {
  local path="$1" command_id status
  command_id="$("${aws_cmd[@]}" ssm send-command --instance-ids "${loadgen_id}" \
    --document-name AWS-RunShellScript \
    --parameters "$(python3 -c 'import json,sys; print(json.dumps({"commands": ["cat " + sys.argv[1]]}))' "${path}")" \
    --query 'Command.CommandId' --output text)" || return 1
  for _poll in $(seq 1 60); do
    status="$("${aws_cmd[@]}" ssm get-command-invocation --command-id "${command_id}" \
      --instance-id "${loadgen_id}" --query 'Status' --output text 2>/dev/null || echo Pending)"
    case "${status}" in Pending|InProgress|Delayed) sleep 5 ;; *) break ;; esac
  done
  [[ "${status}" == Success ]] || return 1
  "${aws_cmd[@]}" ssm get-command-invocation --command-id "${command_id}" \
    --instance-id "${loadgen_id}" --query 'StandardOutputContent' --output text
}

waited=0
outcome=unknown
while true; do
  stage_status="$(remote_read "${runs_root}/${stage_run}/status" 2>/dev/null || echo missing)"
  load_status="$(remote_read "${runs_root}/${load_run}/status" 2>/dev/null || echo missing)"
  stage_status="${stage_status%%$'\n'*}"
  load_status="${load_status%%$'\n'*}"
  log "stage=${stage_status} load=${load_status} waited=${waited}s"
  case "${stage_status}" in
    completed) outcome=completed; break ;;
    failed) outcome=failed; break ;;
  esac
  case "${load_status}" in
    failed) outcome=load-failed; break ;;
  esac
  if (( waited >= max_wait_seconds )); then
    outcome=timeout
    log "watch timed out; destroying so the ceiling cannot be reached"
    break
  fi
  sleep "${poll_seconds}"
  waited=$((waited + poll_seconds))
done
log "phase outcome: ${outcome}"

# Export while the instances still exist: the cost collector reads the live
# inventory, and the evidence collector needs the nodes reachable.
log "collecting node evidence"
LIGHTHOUSE_AWS_REGION="${region}" \
  "${repo_root}/benchmark/scripts/benchmark-collect-aws-stage-b-evidence" "${stage_run}" "${out_dir}/nodes" \
  >> "${out_dir}/phase.log" 2>&1 || log "evidence collection failed; continuing"
log "collecting metered cost"
LIGHTHOUSE_AWS_REGION="${region}" \
  "${repo_root}/benchmark/scripts/benchmark-aws-stage-b-cost" "${stage_run}" "${out_dir}/cost" \
  >> "${out_dir}/phase.log" 2>&1 || log "cost collection failed; continuing"

# Verify the archive before destroying: a run is only accepted when the stage
# archive is readable, reports a completed status, and carries the full timing
# matrix.
verify=0
archive="${out_dir}/${stage_run}.tar.gz"
if "${aws_cmd[@]}" s3 cp "${bucket%/}/artifacts/stage-b/${stage_run}/${stage_run}.tar.gz" "${archive}" \
  --only-show-errors --no-progress; then
  if tar -tzf "${archive}" >/dev/null 2>&1; then
    extract="${out_dir}/extract"
    rm -rf "${extract}"; mkdir -p "${extract}"
    tar -xzf "${archive}" -C "${extract}"
    raw_lines="$(wc -l < "${extract}/${run_prefix}-raw/timings.tsv" 2>/dev/null || echo 0)"
    acc_lines="$(wc -l < "${extract}/${run_prefix}-acceleration/timings.tsv" 2>/dev/null || echo 0)"
    final_status="$(cat "${extract}/${stage_run}/status" 2>/dev/null || echo missing)"
    log "archive: status=${final_status} raw_timings=$((raw_lines > 0 ? raw_lines - 1 : 0)) acceleration_timings=$((acc_lines > 0 ? acc_lines - 1 : 0))"
    if [[ "${final_status}" == completed && "${raw_lines}" == 211 && "${acc_lines}" == 151 ]]; then
      verify=1
    fi
    sha256sum "${archive}" >> "${out_dir}/phase.log"
  else
    log "archive is not readable as a gzip tar"
  fi
else
  log "no stage archive found at ${bucket%/}/artifacts/stage-b/${stage_run}/"
fi

if [[ "${verify}" == 1 ]]; then
  "${aws_cmd[@]}" s3 cp "${out_dir}" "${bucket%/}/results/${stage_run}/" --recursive \
    --only-show-errors --no-progress || log "result bundle upload failed"
fi

log "destroying the topology"
(
  cd "${repo_root}/${stage_dir}"
  tofu destroy -input=false -auto-approve \
    -var image="$(tofu output -raw image)" \
    -var vpc_id="$(tofu output -raw vpc_id)" \
    -var subnet_id="$(tofu output -raw subnet_id)" \
    -var security_group_id="$(tofu output -raw security_group_id)" \
    -var shard_count="${shards}" \
    -var max_lifetime_hours="${lifetime_hours}" \
    -var budget_topic_arn="$(tofu output -raw budget_topic_arn)"
) >> "${out_dir}/phase.log" 2>&1 || log "destroy failed; the node lifetime ceiling remains the backstop"

remaining="$("${aws_cmd[@]}" ec2 describe-instances \
  --filters "Name=tag:experiment,Values=015" "Name=instance-state-name,Values=running,pending" \
  --query 'Reservations[].Instances[].InstanceId' --output text)"
if [[ -z "${remaining//$'\t'/}" ]]; then
  log "teardown confirmed: no Stage B instance is running"
else
  log "WARNING: instances still running after destroy: ${remaining}"
fi

printf 'outcome=%s\nverified=%s\nfinished_at=%s\n' \
  "${outcome}" "${verify}" "$(date -u +%FT%TZ)" > "${out_dir}/result.txt"
cat "${out_dir}/result.txt"
log "phase finished"
