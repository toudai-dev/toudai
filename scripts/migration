#!/bin/sh

# Migration management script
# Usage: ./scripts/migration <command> [args...]

export GOOSE_DRIVER="clickhouse"
export GOOSE_TABLE="migrations"
export GOOSE_DBSTRING="${GOOSE_DBSTRING:-clickhouse://admin:admin@127.0.0.1:9000/toudai_dev}"
export GOOSE_MIGRATION_DIR="${GOOSE_MIGRATION_DIR:-migrations}"

COMMAND="$1"
[ $# -gt 0 ] && shift

case "$COMMAND" in
create)
    if [ $# -eq 0 ]; then
        echo "Usage: $0 create <migration_name>"
        echo "Example: $0 create add new table"
        exit 1
    fi
    NAME="$*"
    goose create "$NAME" sql
    ;;
up)
    goose up
    ;;
down)
    goose down
    ;;
validate)
    goose validate
    ;;
status)
    goose status
    ;;
*)
    echo "Usage: $0 <command> [args...]"
    echo ""
    echo "Commands:"
    echo "  create <name>  Create a new migration"
    echo "  up             Run pending migrations"
    echo "  down           Rollback the last migration"
    echo "  validate       Validate migration files"
    echo "  status         Show migration status"
    echo ""
    echo "Examples:"
    echo "  $0 create add new table"
    echo "  $0 up"
    echo "  $0 down"
    echo "  $0 validate"
    echo "  $0 status"
    exit 1
    ;;
esac
