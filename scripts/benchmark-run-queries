#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
benchmark_root="${LIGHTHOUSE_BENCH_ROOT:-/mnt/fast-storage/lighthouse}"
runs_root="${LIGHTHOUSE_BENCH_RUNS_ROOT:-${benchmark_root}/runs}"
source_path="${LIGHTHOUSE_BENCH_SOURCE:-/mnt/storage/lighthouse/2026-08-01/compact-0000.parquet}"
candidate_order="${LIGHTHOUSE_BENCH_CANDIDATES:-json,map,typed}"
cache_modes="${LIGHTHOUSE_BENCH_CACHE_MODES:-clickhouse-cold,warm}"
repetitions="${LIGHTHOUSE_BENCH_REPETITIONS:-3}"
gcp_bytes_per_event="${LIGHTHOUSE_GCP_BYTES_PER_EVENT:-1900}"
run_id="${1:-$(date -u +%Y%m%dT%H%M%SZ)}"

if [[ ! "${run_id}" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "run ID may contain only letters, numbers, dots, underscores, and hyphens" >&2
  exit 2
fi
if [[ ! "${repetitions}" =~ ^[1-9][0-9]*$ ]]; then
  echo "LIGHTHOUSE_BENCH_REPETITIONS must be a positive integer" >&2
  exit 2
fi
if [[ ! "${gcp_bytes_per_event}" =~ ^[1-9][0-9]*$ ]]; then
  echo "LIGHTHOUSE_GCP_BYTES_PER_EVENT must be a positive integer" >&2
  exit 2
fi

run_dir="${runs_root}/${run_id}"
if [[ -e "${run_dir}" ]]; then
  echo "run directory already exists: ${run_dir}" >&2
  exit 1
fi

mkdir -p "${run_dir}/evidence" "${run_dir}/queries" "${run_dir}/results"
echo "running" > "${run_dir}/status"

client=("${repo_root}/scripts/benchmark-clickhouse" client)
"${client[@]}" --query "SELECT 1" >/dev/null

IFS=',' read -r -a candidates <<< "${candidate_order}"
IFS=',' read -r -a modes <<< "${cache_modes}"
for candidate in "${candidates[@]}"; do
  case "${candidate}" in
    json|map|typed) ;;
    *) echo "unknown candidate: ${candidate}" >&2; exit 2 ;;
  esac
done
for mode in "${modes[@]}"; do
  case "${mode}" in
    clickhouse-cold|warm) ;;
    *) echo "unknown cache mode: ${mode}" >&2; exit 2 ;;
  esac
done

table_state="$("${client[@]}" --query "
  SELECT count(), uniqExact(total_rows), min(total_rows)
  FROM system.tables
  WHERE database = 'benchmark'
    AND name IN ('events_json', 'events_map', 'events_typed')
  FORMAT TSVRaw")"
if [[ "${table_state}" != $'3\t1\t3629077' && "${LIGHTHOUSE_BENCH_ALLOW_OTHER_ROWS:-0}" != "1" ]]; then
  echo "expected three candidate tables with 3,629,077 rows; found: ${table_state}" >&2
  echo "set LIGHTHOUSE_BENCH_ALLOW_OTHER_ROWS=1 for an intentional alternate dataset" >&2
  exit 1
fi

rows="$("${client[@]}" --query "SELECT count() FROM benchmark.events_map FORMAT TSVRaw")"
start="$("${client[@]}" --query "SELECT min(timestamp) FROM benchmark.events_map FORMAT TSVRaw")"
end="$("${client[@]}" --query "SELECT max(timestamp) FROM benchmark.events_map FORMAT TSVRaw")"
IFS=$'\t' read -r service severity < <("${client[@]}" --query "
  SELECT service_name, severity
  FROM benchmark.events_map
  WHERE notEmpty(service_name) AND notEmpty(severity)
  GROUP BY service_name, severity
  ORDER BY count() DESC, service_name, severity
  LIMIT 1 FORMAT TSVRaw")
IFS=$'\t' read -r dynamic_low_value caller < <("${client[@]}" --query "
  SELECT attributes['type'], attributes['caller']
  FROM benchmark.events_map
  WHERE notEmpty(attributes['type']) AND notEmpty(attributes['caller'])
  GROUP BY attributes['type'], attributes['caller']
  ORDER BY count() DESC, attributes['type'], attributes['caller']
  LIMIT 1 FORMAT TSVRaw")
dynamic_high_value="$("${client[@]}" --query "
  SELECT attributes['workspace_id']
  FROM benchmark.events_map
  WHERE notEmpty(attributes['workspace_id'])
  GROUP BY attributes['workspace_id']
  ORDER BY count() DESC, attributes['workspace_id']
  LIMIT 1 FORMAT TSVRaw")"
body_term="${LIGHTHOUSE_BENCH_BODY_TERM:-error}"
logical_input_bytes="$((rows * gcp_bytes_per_event))"

revision_rev="@"
if [[ -z "$(jj diff --summary 2>/dev/null)" ]]; then
  revision_rev="@-"
fi
revision="$(jj log -r "${revision_rev}" --no-graph -T 'commit_id' 2>/dev/null || true)"
change_id="$(jj log -r "${revision_rev}" --no-graph -T 'change_id' 2>/dev/null || true)"
clickhouse_version="$("${client[@]}" --query "SELECT version() FORMAT TSVRaw")"
started_at="$(date -u +%FT%TZ)"
source_bytes=""
source_sha256=""
if [[ -f "${source_path}" ]]; then
  source_bytes="$(stat -c %s "${source_path}")"
  source_sha256="$(sha256sum "${source_path}" | cut -d' ' -f1)"
fi

export RUN_ID="${run_id}" STARTED_AT="${started_at}" REVISION="${revision}"
export CHANGE_ID="${change_id}" CLICKHOUSE_VERSION="${clickhouse_version}"
export CANDIDATE_ORDER="${candidate_order}" CACHE_MODES="${cache_modes}"
export REPETITIONS="${repetitions}" ROWS="${rows}" SOURCE_PATH="${source_path}"
export SOURCE_BYTES="${source_bytes}" SOURCE_SHA256="${source_sha256}"
export GCP_BYTES_PER_EVENT="${gcp_bytes_per_event}" LOGICAL_INPUT_BYTES="${logical_input_bytes}"
export START="${start}" END="${end}" SERVICE="${service}" SEVERITY="${severity}"
export DYNAMIC_LOW_VALUE="${dynamic_low_value}" DYNAMIC_HIGH_VALUE="${dynamic_high_value}"
export CALLER="${caller}" BODY_TERM="${body_term}"
python3 - "${run_dir}/manifest.json" <<'PY'
import json
import os
import sys

manifest = {
    "run_id": os.environ["RUN_ID"],
    "started_at": os.environ["STARTED_AT"],
    "repository": {
        "commit_id": os.environ["REVISION"],
        "change_id": os.environ["CHANGE_ID"],
    },
    "clickhouse_version": os.environ["CLICKHOUSE_VERSION"],
    "candidate_order": os.environ["CANDIDATE_ORDER"].split(","),
    "cache_modes": os.environ["CACHE_MODES"].split(","),
    "cache_policy": {
        "clickhouse-cold": "Drop ClickHouse mark, uncompressed, query, and filesystem caches before each measured query; OS and ZFS ARC remain uncontrolled.",
        "warm": "Run one unmeasured prewarm immediately before measured repetitions; no cache is explicitly dropped.",
    },
    "repetitions": int(os.environ["REPETITIONS"]),
    "dataset": {
        "source_path": os.environ["SOURCE_PATH"],
        "source_physical_bytes": int(os.environ["SOURCE_BYTES"]) if os.environ["SOURCE_BYTES"] else None,
        "source_sha256": os.environ["SOURCE_SHA256"] or None,
        "rows": int(os.environ["ROWS"]),
        "logical_input_method": "provisional GCP-equivalent bytes per event",
        "gcp_equivalent_bytes_per_event": int(os.environ["GCP_BYTES_PER_EVENT"]),
        "logical_input_bytes": int(os.environ["LOGICAL_INPUT_BYTES"]),
        "event_time_start": os.environ["START"],
        "event_time_end": os.environ["END"],
    },
    "parameters": {
        "service": os.environ["SERVICE"],
        "severity": os.environ["SEVERITY"],
        "dynamic_low_value": os.environ["DYNAMIC_LOW_VALUE"],
        "dynamic_high_value": os.environ["DYNAMIC_HIGH_VALUE"],
        "caller": os.environ["CALLER"],
        "body_term": os.environ["BODY_TERM"],
    },
}
with open(sys.argv[1], "w", encoding="utf-8") as output:
    json.dump(manifest, output, indent=2, sort_keys=True)
    output.write("\n")
PY

{
  date -u +%FT%TZ
  uname -a
  lscpu
  free -h
  df -h "${benchmark_root}" "${source_path}"
  if command -v zfs >/dev/null 2>&1; then
    zfs list fast-storage/lighthouse storage/lighthouse-bench
    zfs get compression,recordsize,atime,refquota,mountpoint fast-storage/lighthouse storage/lighthouse-bench
  fi
} > "${run_dir}/evidence/host-storage.txt"
jj status > "${run_dir}/evidence/jj-status.txt" 2>&1 || true
sha256sum "${repo_root}/flake.lock" > "${run_dir}/evidence/flake-lock.sha256"
"${client[@]}" --query "SELECT name, value, changed, description FROM system.settings WHERE changed OR name IN ('max_threads', 'max_memory_usage', 'use_query_cache') ORDER BY name FORMAT JSONEachRow" > "${run_dir}/evidence/settings.jsonl"
"${client[@]}" --query "SELECT name, value FROM system.merge_tree_settings WHERE name LIKE 'object_%' OR name IN ('index_granularity', 'max_bytes_to_merge_at_max_space_in_pool') ORDER BY name FORMAT JSONEachRow" > "${run_dir}/evidence/merge-tree-settings.jsonl"
parts_query="SELECT table, partition, name, rows, bytes_on_disk, data_compressed_bytes, data_uncompressed_bytes, marks, level FROM system.parts WHERE active AND database = 'benchmark' ORDER BY table, partition, name FORMAT JSONEachRow"
merges_query="SELECT database, table, elapsed, progress, num_parts, total_size_bytes_compressed, memory_usage FROM system.merges WHERE database = 'benchmark' ORDER BY table FORMAT JSONEachRow"
"${client[@]}" --query "${parts_query}" > "${run_dir}/evidence/parts-before.jsonl"
"${client[@]}" --query "${merges_query}" > "${run_dir}/evidence/merges-before.jsonl"
printf 'query_id\tcandidate\tcache_mode\tfixture\trepetition\twall_ms\tresult_file\n' > "${run_dir}/timings.tsv"

safe_run_id="$(tr '.-' '__' <<< "${run_id}")"
query_prefix="lighthouse_${safe_run_id}"
query_args=(
  --param_start="${start}"
  --param_end="${end}"
  --param_service="${service}"
  --param_severity="${severity}"
  --param_dynamic_low_value="${dynamic_low_value}"
  --param_dynamic_high_value="${dynamic_high_value}"
  --param_caller="${caller}"
  --param_body_term="${body_term}"
)

capture_query_log() {
  "${client[@]}" --query "SYSTEM FLUSH LOGS" >/dev/null 2>&1 || true
  "${client[@]}" --query "SELECT * FROM system.query_log WHERE startsWith(query_id, '${query_prefix}_') ORDER BY event_time_microseconds FORMAT JSONEachRow" > "${run_dir}/query-log.jsonl" 2>/dev/null || true
  "${client[@]}" --query "
    SELECT query_id, query_duration_ms, read_rows, read_bytes, result_rows,
           memory_usage,
           ProfileEvents['OSCPUVirtualTimeMicroseconds'] AS cpu_us,
           ProfileEvents['SelectedParts'] AS selected_parts,
           ProfileEvents['SelectedMarks'] AS selected_marks
    FROM system.query_log
    WHERE type = 'QueryFinish' AND startsWith(query_id, '${query_prefix}_')
    ORDER BY event_time_microseconds
    FORMAT TSVWithNames
  " > "${run_dir}/query-metrics.tsv" 2>/dev/null || true
}

on_error() {
  echo "failed" > "${run_dir}/status"
  capture_query_log
}
trap on_error ERR

for mode in "${modes[@]}"; do
  for candidate in "${candidates[@]}"; do
    mkdir -p "${run_dir}/queries/${candidate}"
    for source_query in "${repo_root}/benchmark/queries/common/"*.sql "${repo_root}/benchmark/queries/${candidate}/"*.sql; do
      fixture="$(basename "${source_query}" .sql)"
      rendered_query="${run_dir}/queries/${candidate}/${fixture}.sql"
      sed "s|{{table}}|benchmark.events_${candidate}|g" "${source_query}" > "${rendered_query}"

      if [[ "${mode}" == "warm" ]]; then
        prewarm_id="${query_prefix}_prewarm_${candidate}_${fixture//-/_}"
        "${client[@]}" --query_id="${prewarm_id}" "${query_args[@]}" --queries-file "${rendered_query}" >/dev/null
      fi

      for repetition in $(seq 1 "${repetitions}"); do
        if [[ "${mode}" == "clickhouse-cold" ]]; then
          # ClickHouse caches can be reset in-process; the ZFS ARC cannot, so this
          # mode must not be reported as a host-cold measurement.
          "${client[@]}" --multiquery --query "
            SYSTEM DROP MARK CACHE;
            SYSTEM DROP UNCOMPRESSED CACHE;
            SYSTEM DROP QUERY CACHE;
            SYSTEM DROP FILESYSTEM CACHE;
          " >/dev/null
        fi

        fixture_id="${fixture//-/_}"
        query_id="${query_prefix}_${mode//-/_}_${candidate}_${fixture_id}_${repetition}"
        result_file="results/${mode}-${candidate}-${fixture}-r${repetition}.jsonl"
        started_ns="$(date +%s%N)"
        "${client[@]}" --query_id="${query_id}" "${query_args[@]}" --queries-file "${rendered_query}" > "${run_dir}/${result_file}"
        finished_ns="$(date +%s%N)"
        wall_ms="$(((finished_ns - started_ns) / 1000000))"
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
          "${query_id}" "${candidate}" "${mode}" "${fixture}" "${repetition}" "${wall_ms}" "${result_file}" \
          >> "${run_dir}/timings.tsv"
      done
    done
  done
done

capture_query_log
"${client[@]}" --query "${parts_query}" > "${run_dir}/evidence/parts-after.jsonl"
"${client[@]}" --query "${merges_query}" > "${run_dir}/evidence/merges-after.jsonl"
date -u +%FT%TZ > "${run_dir}/completed-at"
echo "completed" > "${run_dir}/status"
trap - ERR

echo "benchmark query run completed: ${run_dir}"
